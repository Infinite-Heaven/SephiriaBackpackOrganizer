<Project Sdk="Microsoft.NET.Sdk">

  <!-- BepInEx 5 兼容构建：定义 BEPINEX5 符号，引用 BepInEx 5 的 BepInEx.dll（plugin/libs-bep5） -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SephiriaBackpackOrganizer</AssemblyName>
    <RootNamespace>SephiriaBackpackOrganizer</RootNamespace>
    <Version>2.5.1</Version>
    <GameDirectory Condition="'$(GameDirectory)' == ''">E:\steam\steamapps\common\Sephiria</GameDirectory>
    <BepInExCoreDirectory Condition="'$(BepInExCoreDirectory)' == ''">$(GameDirectory)\BepInEx\core</BepInExCoreDirectory>
    <DefineConstants>$(DefineConstants);BEPINEX5</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>embedded</DebugType>
    <!-- 隐藏本机构建路径（异常堆栈不泄露 C:\Users\... 等绝对路径） -->
    <PathMap>$(MSBuildProjectDirectory)=SephiriaBackpackOrganizer</PathMap>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <!-- 输出到独立目录，避免与 BepInEx 6 构建互相覆盖 -->
    <OutputPath>bin5\Release\</OutputPath>
    <!-- 独立中间目录：与 6 版 csproj 同目录，默认 obj/ 会互相覆盖导致条件编译不生效 -->
    <BaseIntermediateOutputPath>obj5\</BaseIntermediateOutputPath>
    <!-- 排除 6 版项目的中间/输出目录（同目录下默认通配符会误包含其自动生成的 AssemblyInfo） -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 5 (Unity Mono) -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDirectory)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- 游戏程序集 (Sephiria, E:\SteamLibrary) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDirectory)\Sephiria_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(GameDirectory)\Sephiria_Data\Managed\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDirectory)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity 引擎 -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameDirectory)\Sephiria_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDirectory)\Sephiria_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDirectory)\Sephiria_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDirectory)\Sephiria_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDirectory)\Sephiria_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDirectory)\Sephiria_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- 新输入系统（游戏实际使用） -->
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameDirectory)\Sephiria_Data\Managed\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
